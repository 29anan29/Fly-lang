"""
examples/safe_math.fly — 纯计算示例（无需任何外部能力）

对应 PyFly 编译期检查：
  safe   → 污点追踪（此处无外部输入）
  guard  → 参数校验
  trace  → 审计日志
"""
guard x: int, x > 0
guard y: int, y > 0

trace(level="INFO", args=True):
def fibonacci(n: int) -> int:
    """计算斐波那契数列第 n 项"""
    if n <= 1:
        return n
    a, b = 0, 1
    for _ in range(n - 1):
        a, b = b, a + b
    return b

def main():
    # 计算前 20 项
    results = []
    for i in range(1, 21):
        results.append(fibonacci(i))

    print(f"Fibonacci(20) = {fibonacci(20)}")
    print(f"Sum of first 20 = {sum(results)}")

    # 验证 guard
    try:
        fibonacci(-1)
    except Exception as e:
        print(f"Guard correctly rejected negative input: {e}")

if __name__ == "__main__":
    main()
