"""
examples/file_read.fly — 需要文件读取能力的示例

运行方式:
  fly-sandbox file_read.py --cap-fs-read /tmp/allowed
"""
only (json, os):
def read_config(path: str) -> dict:
    """读取 JSON 配置文件"""
    trace(level="INFO"):
    with open(path, 'r') as f:
        return json.load(f)

def main():
    config_path = "/tmp/allowed/config.json"
    try:
        config = read_config(config_path)
        print(f"Config loaded: {config}")
    except PermissionError as e:
        print(f"Access denied: {e}")
    except FileNotFoundError as e:
        print(f"File not found: {e}")

    # 尝试读取未授权路径 → 应被拒绝
    try:
        with open("/etc/passwd", 'r') as f:
            data = f.read()
        print(f"ERROR: Should not be able to read /etc/passwd ({len(data)} bytes)")
    except PermissionError:
        print("OK: /etc/passwd correctly denied")

if __name__ == "__main__":
    main()
