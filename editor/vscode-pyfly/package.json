{
  "name": "pyfly-lang",
  "displayName": "PyFly",
  "description": "PyFly 语言支持：Python 3.10+ 安全增强超集。LSP 编译期诊断（safe/only/lock/mask/cage/guard/seal/trace）+ 语法高亮",
  "version": "0.3.0",
  "publisher": "29anan29",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/29anan29/PyFly-lang"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "fly",
    "python",
    "security",
    "transpiler"
  ],
  "activationEvents": [
    "onLanguage:fly",
    "onCommand:fly.build",
    "onCommand:fly.check",
    "onCommand:fly.run",
    "onCommand:fly.update",
    "onCommand:fly.updateExtension"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fly",
        "aliases": [
          "Fly",
          "fly"
        ],
        "extensions": [
          ".fly"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fly",
        "scopeName": "source.fly",
        "path": "./syntaxes/fly.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fly.build",
        "title": "PyFly: Build to Python",
        "category": "PyFly"
      },
      {
        "command": "fly.check",
        "title": "PyFly: Check",
        "category": "PyFly"
      },
      {
        "command": "fly.run",
        "title": "PyFly: Run",
        "category": "PyFly"
      },
      {
        "command": "fly.update",
        "title": "PyFly: Check for Updates",
        "category": "PyFly"
      },
      {
        "command": "fly.updateExtension",
        "title": "Check Extension Update",
        "category": "PyFly"
      }
    ],
    "configuration": {
      "title": "PyFly",
      "properties": {
        "fly.path": {
          "type": "string",
          "default": "fly",
          "description": "fly 可执行文件路径（默认从 PATH 查找），内置 LSP 服务器（fly lsp）"
        },
        "fly.proxy": {
          "type": "string",
          "default": "",
          "description": "更新检查使用的代理（http://、https://、socks5://）"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}