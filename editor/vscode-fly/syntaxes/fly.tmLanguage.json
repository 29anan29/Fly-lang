{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fly",
  "scopeName": "source.fly",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#fly-keywords" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.fly",
          "begin": "#",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.fly",
          "begin": "(?i)(r|u|f|b|rf|fr|rb|br)?('''|\"\"\")",
          "end": "\\2",
          "beginCaptures": {
            "1": { "name": "storage.type.string.fly" }
          }
        },
        {
          "name": "string.quoted.single.fly",
          "begin": "(?i)(r|u|f|b|rf|fr|rb|br)?('|\")",
          "end": "\\2",
          "beginCaptures": {
            "1": { "name": "storage.type.string.fly" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.fly",
              "match": "\\\\(\\\\|'|\"|n|r|t|0|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            },
            {
              "name": "constant.other.placeholder.fly",
              "match": "\\{[^}]*\\}"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fly",
          "match": "\\b(def|class|if|elif|else|for|while|return|raise|try|except|finally|pass|break|continue|import|from|as|in|is|not|and|or|del|with|assert|global|nonlocal|lambda|yield|async|await)\\b"
        },
        {
          "name": "constant.language.fly",
          "match": "\\b(None|True|False)\\b"
        }
      ]
    },
    "fly-keywords": {
      "patterns": [
        {
          "name": "keyword.control.fly-security",
          "match": "\\b(safe|mask|lock|guard)\\b"
        },
        {
          "name": "keyword.control.fly-runtime",
          "match": "\\b(only|cage|seal|trace)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fly",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|\\d[\\d_]*(\\.[\\d_]*)?([eE][+-]?\\d+)?)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fly",
          "match": "(\\*\\*=|//=|<<=|>>=|[+*/%&|^~<>!]=?|\\*\\*|//|<<|>>|==|!=|<=|>=|->|\\*|\\+|\\-|/|%|&|\\||\\^|~|=|:)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.fly",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.object.property.fly",
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    }
  }
}
