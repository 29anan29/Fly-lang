# FlyToDos —— 用 Fly-Lang（Python 3.10+ 安全超集）像素级复刻
# 原版：Wails + Vue（Organic Biophilic 主题）；本版：纯标准库 Web 应用，零依赖。
# 用法：fly build example/flytodos/app.fly -o app.py && python3 app.py
# 访问：http://127.0.0.1:8765

import json
import os
import threading
from datetime import datetime, timezone
from functools import cmp_to_key
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

DATA_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "flytodos_data.json")

STATUSES = ["pending", "in_progress", "completed", "cancelled"]
PRIORITIES = ["low", "medium", "high"]
COLORS = ["#228B22", "#8B4513", "#87CEEB", "#D2B48C", "#556B2F", "#CD853F", "#6B8E23", "#B8860B"]

db_lock = threading.Lock()


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def empty_db():
    return {"tasks": [], "inspirations": [], "next_id": 1}


def load_db():
    try:
        f = open(DATA_FILE, encoding="utf-8")
    except Exception:
        return empty_db()
    try:
        return json.load(f)
    except Exception:
        return empty_db()
    finally:
        f.close()


def save_db(db):
    f = open(DATA_FILE, "w", encoding="utf-8")
    try:
        json.dump(db, f, ensure_ascii=False, indent=2)
    finally:
        f.close()


def new_id(db):
    db["next_id"] += 1
    return db["next_id"] - 1


def find_task(tasks, tid):
    for t in tasks:
        if t["id"] == tid:
            return t
        found = find_task(t.get("children") or [], tid)
        if found is not None:
            return found
    return None


def collect_ids(task):
    ids = [task["id"]]
    for c in task.get("children") or []:
        ids.extend(collect_ids(c))
    return ids


def build_tree(db):
    by_parent = {}
    for t in db["tasks"]:
        pid = t.get("parentId")
        if pid not in by_parent:
            by_parent[pid] = []
        by_parent[pid].append(t)

    def cmp(a, b):
        sa = a.get("sortOrder") or 0
        sb = b.get("sortOrder") or 0
        if sa != sb:
            return -1 if sa < sb else 1
        if a["id"] != b["id"]:
            return -1 if a["id"] < b["id"] else 1
        return 0

    def make(pid):
        nodes = []
        for t in sorted(by_parent.get(pid) or [], key=cmp_to_key(cmp)):
            node = dict(t)
            node["children"] = make(t["id"])
            nodes.append(node)
        return nodes

    return make(None)


def remove_task(db, tid):
    ids = set()

    def collect(tasks):
        for t in tasks:
            if t["id"] == tid:
                ids.update(collect_ids(t))
                return True
            if collect(t.get("children") or []):
                return True
        return False

    collect(db["tasks"])
    if not ids:
        return False
    kept = []
    for t in db["tasks"]:
        if t["id"] not in ids:
            kept.append(t)
    db["tasks"] = kept
    return True


def normalize_task(payload):
    task = {
        "id": payload.get("id"),
        "parentId": payload.get("parentId"),
        "title": (payload.get("title") or "").strip(),
        "description": payload.get("description") or "",
        "status": payload.get("status") or "pending",
        "priority": payload.get("priority") if payload.get("priority") in PRIORITIES else "medium",
        "sortOrder": payload.get("sortOrder") or 0,
        "dueDate": payload.get("dueDate"),
        "createdAt": payload.get("createdAt") or now_iso(),
        "updatedAt": now_iso(),
        "completedAt": payload.get("completedAt"),
    }
    return task


def normalize_inspiration(payload):
    tags = payload.get("tags") or []
    color = payload.get("color")
    if color not in COLORS:
        color = COLORS[0]
    return {
        "id": payload.get("id"),
        "title": (payload.get("title") or "").strip(),
        "content": payload.get("content") or "",
        "tags": tags,
        "color": color,
        "pinned": bool(payload.get("pinned")),
        "createdAt": payload.get("createdAt") or now_iso(),
        "updatedAt": now_iso(),
    }


def db_locked(fn):
    db_lock.acquire()
    try:
        return fn()
    finally:
        db_lock.release()


def insp_cmp(a, b):
    if a["pinned"] != b["pinned"]:
        return -1 if a["pinned"] else 1
    if a["id"] != b["id"]:
        return -1 if a["id"] < b["id"] else 1
    return 0


def insp_sorted(items):
    return sorted(items, key=cmp_to_key(insp_cmp))


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def _send(self, status, obj):
        body = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _send_html(self, page):
        body = page.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _read_json(self):
        try:
            length = int(self.headers.get("Content-Length") or 0)
            if length <= 0 or length > 1 << 20:
                return None
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except Exception:
            return None

    def _error(self, status, message):
        self._send(status, {"error": message})

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/" or parsed.path == "/index.html":
            self._send_html(PAGE)
            return
        if parsed.path == "/api/tasks":
            def work():
                return build_tree(db_locked(load_db))
            self._send(200, work())
            return
        if parsed.path == "/api/inspirations":
            qs = parse_qs(parsed.query)
            keyword = (qs.get("q") or [""])[0].strip().lower()
            db = db_locked(load_db)
            items = db["inspirations"]
            if keyword:
                items = []
                for i in db["inspirations"]:
                    hit = keyword in i["title"].lower() or keyword in i["content"].lower()
                    if not hit:
                        for t in i["tags"]:
                            if keyword in t.lower():
                                hit = True
                                break
                    if hit:
                        items.append(i)
            items = insp_sorted(items)
            self._send(200, items)
            return
        self._error(404, "not found")

    def do_POST(self):
        parsed = urlparse(self.path)
        payload = self._read_json()
        if payload is None:
            self._error(400, "请求体不是合法 JSON")
            return
        if parsed.path == "/api/tasks":
            def work():
                db = load_db()
                task = normalize_task(payload)
                task["id"] = new_id(db)
                db["tasks"].append(task)
                save_db(db)
                return task
            self._send(200, db_locked(work))
            return
        if parsed.path == "/api/inspirations":
            def work():
                db = load_db()
                item = normalize_inspiration(payload)
                item["id"] = new_id(db)
                db["inspirations"].append(item)
                save_db(db)
                return item
            self._send(200, db_locked(work))
            return
        if parsed.path.startswith("/api/tasks/") and parsed.path.endswith("/status"):
            def work():
                db = load_db()
                tid = int(parsed.path.split("/")[3])
                status = payload.get("status")
                if status not in STATUSES:
                    return None, 400, "非法状态"
                task = find_task(build_tree(db), tid)
                if task is None:
                    return None, 404, "任务不存在"
                task["status"] = status
                task["updatedAt"] = now_iso()
                if status == "completed":
                    task["completedAt"] = now_iso()
                else:
                    task["completedAt"] = None
                save_db(db)
                return task, 200, ""
            result = db_locked(work)
            if result[1] == 200:
                self._send(200, result[0])
            else:
                self._error(result[1], result[2])
            return
        if parsed.path.startswith("/api/inspirations/") and parsed.path.endswith("/pin"):
            def work():
                db = load_db()
                tid = int(parsed.path.split("/")[3])
                for i in db["inspirations"]:
                    if i["id"] == tid:
                        i["pinned"] = not i["pinned"]
                        i["updatedAt"] = now_iso()
                        save_db(db)
                        return i
                return None
            result = db_locked(work)
            if result is None:
                self._error(404, "灵感不存在")
            else:
                self._send(200, result)
            return
        self._error(404, "not found")

    def do_PATCH(self):
        parsed = urlparse(self.path)
        payload = self._read_json()
        if payload is None:
            self._error(400, "请求体不是合法 JSON")
            return
        if parsed.path.startswith("/api/tasks/"):
            def work():
                db = load_db()
                tid = int(parsed.path.split("/")[3])
                task = find_task(db["tasks"], tid)
                if task is None:
                    return None, 404, "任务不存在"
                for key in ("title", "description", "priority", "dueDate", "parentId", "sortOrder"):
                    if key in payload:
                        task[key] = payload[key]
                if "status" in payload and payload["status"] in STATUSES:
                    task["status"] = payload["status"]
                    if payload["status"] == "completed":
                        task["completedAt"] = now_iso()
                    else:
                        task["completedAt"] = None
                task["updatedAt"] = now_iso()
                save_db(db)
                return task, 200, ""
            result = db_locked(work)
            if result[1] == 200:
                self._send(200, result[0])
            else:
                self._error(result[1], result[2])
            return
        if parsed.path.startswith("/api/inspirations/"):
            def work():
                db = load_db()
                tid = int(parsed.path.split("/")[3])
                for i in db["inspirations"]:
                    if i["id"] == tid:
                        for key in ("title", "content", "color", "pinned"):
                            if key in payload:
                                i[key] = payload[key]
                        if "tags" in payload:
                            i["tags"] = payload["tags"]
                        i["updatedAt"] = now_iso()
                        save_db(db)
                        return i, 200, ""
                return None, 404, "灵感不存在"
            result = db_locked(work)
            if result[1] == 200:
                self._send(200, result[0])
            else:
                self._error(result[1], result[2])
            return
        self._error(404, "not found")

    def do_DELETE(self):
        parsed = urlparse(self.path)
        if parsed.path.startswith("/api/tasks/"):
            def work():
                db = load_db()
                tid = int(parsed.path.split("/")[3])
                if remove_task(db, tid):
                    save_db(db)
                    return True
                return False
            ok = db_locked(work)
            if ok:
                self._send(200, {"ok": True})
            else:
                self._error(404, "任务不存在")
            return
        if parsed.path.startswith("/api/inspirations/"):
            def work():
                db = load_db()
                tid = int(parsed.path.split("/")[3])
                before = len(db["inspirations"])
                kept = []
                for i in db["inspirations"]:
                    if i["id"] != tid:
                        kept.append(i)
                db["inspirations"] = kept
                if len(db["inspirations"]) != before:
                    save_db(db)
                    return True
                return False
            ok = db_locked(work)
            if ok:
                self._send(200, {"ok": True})
            else:
                self._error(404, "灵感不存在")
            return
        self._error(404, "not found")


def main():
    server = ThreadingHTTPServer(("127.0.0.1", 8765), Handler)
    print("FlyToDos 运行中: http://127.0.0.1:8765")
    server.serve_forever()


PAGE = """<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FlyToDos</title>
<style>
:root {
  --forest: #228B22;
  --forest-400: #3AA13A;
  --forest-500: #228B22;
  --forest-600: #1E7A1E;
  --forest-700: #17651A;
  --forest-800: #124F16;
  --forest-900: #0D3D11;
  --earth: #8B4513;
  --earth-300: #C8966A;
  --earth-400: #A9744E;
  --earth-500: #8B5A33;
  --earth-800: #4A2A0F;
  --sky-300: #87CEEB;
  --beige: #F5F5DC;
  --beige-50: #F5F5DC;
  --beige-100: #EDEDC8;
  --beige-400: #C9C98E;
  --radius-organic: 20px;
  --radius-organic-lg: 28px;
  --radius-organic-sm: 12px;
  --shadow-natural: 0 4px 20px -4px rgba(34, 139, 34, 0.15);
  --shadow-natural-lg: 0 12px 32px -8px rgba(34, 139, 34, 0.35);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: 'Nunito', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  color: var(--earth-800);
  -webkit-font-smoothing: antialiased;
  background: #F5F5DC;
  background-image:
    radial-gradient(circle at 10% 10%, rgba(135, 206, 235, 0.08) 0%, transparent 40%),
    radial-gradient(circle at 90% 90%, rgba(34, 139, 34, 0.06) 0%, transparent 40%);
}
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(34, 139, 34, 0.4); border-radius: 9999px; }

.app-shell {
  display: flex;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
  border-radius: 24px;
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
  border: 1px solid rgba(0,0,0,0.05);
}
.app-body { display: flex; flex: 1; overflow: hidden; }
.main-col { display: flex; flex: 1; flex-direction: column; overflow: hidden; }
main { flex: 1; overflow-y: auto; padding: 24px 32px; }

.titlebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 20px;
  background: var(--forest-800);
  color: var(--beige-50);
  font-size: 12px;
  user-select: none;
}
.titlebar .dot { color: var(--sky-300); margin-right: 8px; }

.sidebar { display: flex; width: 256px; background: var(--forest-800); padding: 12px; }
.sidebar-card {
  display: flex; flex: 1; flex-direction: column;
  background: var(--forest-700);
  color: var(--beige-50);
  border-radius: var(--radius-organic-lg);
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.35);
  border: 1px solid rgba(34,139,34,0.2);
  transition: transform .5s cubic-bezier(.16,1,.3,1), box-shadow .5s, background-color .5s;
}
.sidebar-card:hover { transform: translateY(-4px); background: var(--forest-600); box-shadow: var(--shadow-natural-lg); }
.sidebar-logo { padding: 28px 24px; }
.sidebar-logo h1 { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
.sidebar-logo p { margin-top: 4px; font-size: 12px; color: #BBE3BB; }
.sidebar nav { flex: 1; padding: 16px 12px; display: flex; flex-direction: column; gap: 8px; }
.nav-item {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px; border-radius: var(--radius-organic-sm);
  font-size: 14px; font-weight: 500; color: #D8EFD8; cursor: pointer;
  border: none; background: none; font-family: inherit; width: 100%; text-align: left;
  transition: background-color .3s cubic-bezier(.16,1,.3,1), color .3s;
}
.nav-item:hover { background: rgba(34,139,34,0.35); }
.nav-item.active { background: var(--forest-500); color: #fff; box-shadow: var(--shadow-natural); }
.nav-item .badge {
  margin-left: auto; background: rgba(135,206,235,0.3); border-radius: 9999px;
  padding: 2px 8px; font-size: 12px;
}
.sidebar-foot { padding: 16px 24px; font-size: 12px; color: rgba(187,227,187,0.7); }

.topbar { padding: 14px 32px; background: rgba(245,245,220,0.6); border-bottom: 1px solid rgba(34,139,34,0.08); }
.topbar h2 { font-size: 18px; font-weight: 700; color: var(--forest-800); }

.organic-card {
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(6px);
  border-radius: var(--radius-organic);
  box-shadow: var(--shadow-natural);
  border: 1px solid rgba(34,139,34,0.08);
}
.organic-input {
  width: 100%; padding: 10px 16px; border-radius: var(--radius-organic-sm);
  background: rgba(255,255,255,0.85); border: 1px solid #BFD9BF;
  color: var(--earth-800); font-family: inherit; font-size: 14px;
  transition: box-shadow .2s, border-color .2s;
}
.organic-input:focus { outline: none; box-shadow: 0 0 0 2px rgba(34,139,34,0.4); border-color: transparent; }
.organic-input::placeholder { color: #B8B88E; }
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 18px; border-radius: var(--radius-organic-sm);
  background: var(--forest-500); color: #fff; border: none;
  font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
  transition: background-color .2s, transform .15s;
}
.btn:hover { background: var(--forest-600); }
.btn:active { transform: scale(0.97); }
.btn.ghost { background: transparent; color: var(--forest-600); }
.btn.ghost:hover { background: rgba(34,139,34,0.08); }
.btn.sm { padding: 6px 12px; font-size: 13px; }

.quick-add {
  display: flex; align-items: center; gap: 8px; padding: 12px; margin-bottom: 24px;
}
.quick-add .plus { margin-left: 8px; color: var(--forest-500); font-size: 20px; }
.quick-add input {
  flex: 1; border: none; background: transparent; padding: 8px; font-family: inherit;
  font-size: 14px; color: var(--earth-800);
}
.quick-add input:focus { outline: none; }
.quick-add input::placeholder { color: #B8B88E; }

.task-row {
  display: flex; align-items: center; gap: 8px; padding: 8px;
  border-radius: var(--radius-organic-sm); transition: background-color .2s;
}
.task-row:hover { background: rgba(34,139,34,0.05); }
.task-row.completed { opacity: 0.6; }
.task-row.completed .task-title { text-decoration: line-through; }
.chevron {
  width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;
  border: none; background: none; color: var(--earth-500); cursor: pointer; border-radius: 6px;
  transition: transform .25s;
}
.chevron:hover { color: var(--forest-600); }
.chevron.open { transform: rotate(90deg); }
.chevron.leaf { visibility: hidden; }
.check {
  width: 20px; height: 20px; border-radius: 9999px; border: 2px solid var(--beige-400);
  background: none; cursor: pointer; display: flex; align-items: center; justify-content: center;
  color: transparent; transition: all .2s; font-size: 12px;
}
.check:hover { border-color: var(--forest-400); }
.check.done { background: var(--forest-500); border-color: var(--forest-500); color: #fff; }
.priority-dot { width: 10px; height: 10px; border-radius: 9999px; flex-shrink: 0; }
.priority-dot.low { background: var(--sky-300); }
.priority-dot.medium { background: var(--beige-400); }
.priority-dot.high { background: var(--earth-400); }
.task-title { flex: 1; font-size: 14px; min-width: 0; }
.task-title.clickable { cursor: pointer; user-select: none; }
.status-badge {
  font-size: 11px; padding: 2px 10px; border-radius: 9999px; white-space: nowrap;
}
.status-badge.pending { background: rgba(200,200,142,0.25); color: #6B6B2A; }
.status-badge.in_progress { background: rgba(135,206,235,0.3); color: #2A6B87; }
.status-badge.completed { background: rgba(34,139,34,0.2); color: var(--forest-600); }
.status-badge.cancelled { background: rgba(139,69,19,0.15); color: var(--earth-500); }
.due { font-size: 12px; color: var(--earth-500); white-space: nowrap; }
.icon-btn {
  border: none; background: none; cursor: pointer; padding: 5px; border-radius: 8px;
  color: var(--earth-400); transition: color .2s, background-color .2s; font-size: 14px;
}
.icon-btn:hover { color: var(--forest-600); background: rgba(34,139,34,0.08); }
.icon-btn.danger:hover { color: #C0392B; background: rgba(192,57,43,0.08); }
.task-children { margin-left: 28px; }
.task-desc { margin-left: 56px; padding: 4px 12px 12px; font-size: 13px; color: var(--earth-400); white-space: pre-wrap; }

.empty { text-align: center; padding: 56px 0; color: var(--earth-500); }
.empty .blob { margin: 0 auto 16px; }
.empty h3 { font-size: 20px; font-weight: 700; color: var(--forest-700); margin-bottom: 8px; }
.empty p { font-size: 14px; margin-bottom: 20px; }

.toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 24px; }
.search-card { display: flex; flex: 1; align-items: center; gap: 8px; padding: 10px 16px; min-width: 220px; }
.search-card .icon { color: var(--earth-400); }
.search-card input { flex: 1; border: none; background: transparent; font-family: inherit; font-size: 14px; }
.search-card input:focus { outline: none; }

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
.ins-card {
  background: rgba(255,255,255,0.9); border-radius: var(--radius-organic);
  box-shadow: var(--shadow-natural); border: 1px solid rgba(34,139,34,0.08);
  overflow: hidden; display: flex; flex-direction: column;
  transition: transform .3s cubic-bezier(.16,1,.3,1), box-shadow .3s;
}
.ins-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-natural-lg); }
.ins-top { height: 8px; }
.ins-body { padding: 16px 20px; flex: 1; }
.ins-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.ins-head h4 { font-size: 16px; font-weight: 700; color: var(--earth-800); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ins-content { margin-top: 8px; font-size: 13px; color: var(--earth-400); white-space: pre-wrap; max-height: 120px; overflow-y: auto; }
.ins-tags { display: flex; flex-wrap: wrap; gap: 6px; padding: 12px 20px; }
.tag-chip {
  font-size: 11px; background: rgba(34,139,34,0.08); color: var(--forest-600);
  padding: 2px 10px; border-radius: 9999px;
}
.ins-foot { display: flex; align-items: center; justify-content: space-between; padding: 10px 20px; border-top: 1px solid rgba(34,139,34,0.06); }
.ins-foot .date { font-size: 11px; color: var(--earth-300); }

.modal-mask {
  position: fixed; inset: 0; background: rgba(13,61,17,0.4); backdrop-filter: blur(3px);
  display: flex; align-items: center; justify-content: center; z-index: 50;
}
.modal {
  width: 480px; max-width: calc(100vw - 48px); max-height: calc(100vh - 64px); overflow-y: auto;
  background: var(--beige-50); border-radius: var(--radius-organic-lg); padding: 24px;
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.4);
}
.modal h3 { font-size: 18px; font-weight: 700; color: var(--forest-800); margin-bottom: 16px; }
.field { margin-bottom: 14px; }
.field label { display: block; font-size: 12px; font-weight: 600; color: var(--forest-700); margin-bottom: 6px; }
.field-row { display: flex; gap: 12px; }
.field-row .field { flex: 1; }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
select.organic-input { appearance: none; }
.color-row { display: flex; gap: 8px; flex-wrap: wrap; }
.color-dot {
  width: 26px; height: 26px; border-radius: 9999px; cursor: pointer;
  border: 3px solid transparent; transition: transform .15s, border-color .15s;
}
.color-dot:hover { transform: scale(1.15); }
.color-dot.sel { border-color: var(--forest-800); transform: scale(1.15); }
.loading { text-align: center; padding: 48px 0; color: var(--earth-500); }
</style>
</head>
<body>
<div class="app-shell">
  <div class="titlebar"><span><span class="dot">●</span>FlyToDos</span><span>Organic Biophilic</span></div>
  <div class="app-body">
    <aside class="sidebar">
      <div class="sidebar-card">
        <div class="sidebar-logo">
          <h1>FlyToDos</h1>
          <p>自然生长的待办与灵感</p>
        </div>
        <nav>
          <button class="nav-item active" id="nav-tasks" onclick="showView('tasks')">☑ 任务</button>
          <button class="nav-item" id="nav-inspirations" onclick="showView('inspirations')">✦ 灵感 <span class="badge" id="ins-badge" style="display:none">0</span></button>
        </nav>
        <div class="sidebar-foot">Fly-Lang 像素级复刻<br>Organic Biophilic</div>
      </div>
    </aside>
    <div class="main-col">
      <div class="topbar"><h2 id="view-title">任务</h2></div>
      <main id="view-root"></main>
    </div>
  </div>
</div>
<script>
const $ = (sel) => document.querySelector(sel);
let current = 'tasks';

async function api(path, opts) {
  const res = await fetch(path, opts);
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || '请求失败');
  return data;
}
const get = (p) => api(p);
const post = (p, body) => api(p, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
const patch = (p, body) => api(p, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
const del = (p) => api(p, { method: 'DELETE' });

const ICON = {
  chevron: '<span style="display:inline-block">›</span>',
  trash: '🗑', edit: '✎', plus: '＋', play: '▶', pin: '📌', unpin: '○'
};

function showView(name) {
  current = name;
  $('#nav-tasks').classList.toggle('active', name === 'tasks');
  $('#nav-inspirations').classList.toggle('active', name === 'inspirations');
  $('#view-title').textContent = name === 'tasks' ? '任务' : '灵感';
  if (name === 'tasks') renderTasks(); else renderInspirations();
}

/* ---------- 任务 ---------- */
let quickTitle = '';
let expandedSet = new Set();

function renderTasks() {
  const root = $('#view-root');
  root.innerHTML = '<div class="quick-add organic-card"><span class="plus">＋</span><input id="quick-input" placeholder="添加一个新任务，回车快速创建..." value=""></div><div id="tree-root" class="loading">加载中...</div>';
  $('#quick-input').addEventListener('keydown', async (e) => {
    if (e.key !== 'Enter') return;
    const title = e.target.value.trim();
    if (!title) return;
    e.target.value = '';
    await post('/api/tasks', { title, description: '', priority: 'medium' });
    renderTasks();
  });
  get('/api/tasks').then((tree) => {
    const box = $('#tree-root');
    if (tree.length === 0) {
      box.className = '';
      box.innerHTML = emptyHTML('还没有任务', '在上方输入框中添加你的第一个任务，开始自然生长的待办之旅。', () => openTaskForm(null));
      return;
    }
    box.className = '';
    box.innerHTML = tree.map(taskHTML).join('');
    wireTree(box);
  }).catch(() => { $('#tree-root').textContent = '加载失败'; });
}

function taskHTML(node, depth) {
  if (depth === 0 && expandedSet.size === 0) expandedSet.add(node.id);
  const hasKids = node.children.length > 0;
  const open = expandedSet.has(node.id) || (depth === 0 && !expandedSet.has(-node.id));
  const done = node.status === 'completed';
  const due = node.dueDate ? `<span class="due">📅 ${fmtDue(node.dueDate)}</span>` : '';
  const kids = hasKids && open ? `<div class="task-children">${node.children.map(c => taskHTML(c, depth + 1)).join('')}</div>` : '';
  const desc = node.description ? `<div class="task-desc">${esc(node.description)}</div>` : '';
  return `<div>
    <div class="task-row ${done ? 'completed' : ''}">
      <button class="chevron ${hasKids ? (open ? 'open' : '') : 'leaf'}" data-act="toggle" data-id="${node.id}">›</button>
      <button class="check ${done ? 'done' : ''}" data-act="check" data-id="${node.id}" title="${done ? '标记为待办' : '标记为完成'}">✓</button>
      <span class="priority-dot ${node.priority}"></span>
      <span class="task-title clickable" data-act="cycle" data-id="${node.id}" title="点击切换状态">${esc(node.title)}</span>
      <span class="status-badge ${node.status}">${statusLabel(node.status)}</span>
      ${due}
      <button class="icon-btn" data-act="sub" data-id="${node.id}" title="添加子任务">＋</button>
      <button class="icon-btn" data-act="edit" data-id="${node.id}" title="编辑">✎</button>
      <button class="icon-btn danger" data-act="del" data-id="${node.id}" title="删除">🗑</button>
    </div>
    ${desc}
    ${kids}
  </div>`;
}

function wireTree(box) {
  box.querySelectorAll('[data-act]').forEach((el) => {
    el.addEventListener('click', async () => {
      const act = el.dataset.act, id = Number(el.dataset.id);
      if (act === 'toggle') {
        if (expandedSet.has(id)) expandedSet.delete(id); else expandedSet.add(id);
        renderTasks();
      } else if (act === 'check') {
        const t = await get('/api/tasks').then(ts => findInTree(ts, id));
        await post('/api/tasks/' + id + '/status', { status: t.status === 'completed' ? 'pending' : 'completed' });
        renderTasks();
      } else if (act === 'cycle') {
        const order = ['pending', 'in_progress', 'completed', 'cancelled'];
        const t = await get('/api/tasks').then(ts => findInTree(ts, id));
        const idx = order.indexOf(t.status);
        await post('/api/tasks/' + id + '/status', { status: order[(idx + 1) % order.length] });
        renderTasks();
      } else if (act === 'sub') {
        openTaskForm(id);
      } else if (act === 'edit') {
        const t = await get('/api/tasks').then(ts => findInTree(ts, id));
        openTaskForm(id, t);
      } else if (act === 'del') {
        const t = await get('/api/tasks').then(ts => findInTree(ts, id));
        if (!confirm('确定删除任务"' + t.title + '"及其所有子任务？')) return;
        await del('/api/tasks/' + id);
        renderTasks();
      }
    });
  });
}

function findInTree(nodes, id) {
  for (const n of nodes) {
    if (n.id === id) return n;
    const f = findInTree(n.children, id);
    if (f) return f;
  }
  return null;
}

function openTaskForm(parentId, task) {
  openModal(`
    <h3>${task ? '编辑任务' : (parentId ? '添加子任务' : '新建任务')}</h3>
    <div class="field"><label>标题</label><input class="organic-input" id="f-title" value="${task ? escAttr(task.title) : ''}" placeholder="任务标题"></div>
    <div class="field"><label>描述</label><textarea class="organic-input" id="f-desc" rows="3" placeholder="补充说明...">${task ? esc(task.description) : ''}</textarea></div>
    <div class="field-row">
      <div class="field"><label>优先级</label>
        <select class="organic-input" id="f-priority">
          <option value="low" ${task && task.priority === 'low' ? 'selected' : ''}>低</option>
          <option value="medium" ${!task || task.priority === 'medium' ? 'selected' : ''}>中</option>
          <option value="high" ${task && task.priority === 'high' ? 'selected' : ''}>高</option>
        </select>
      </div>
      <div class="field"><label>截止日期</label><input class="organic-input" id="f-due" type="date" value="${task && task.dueDate ? task.dueDate.slice(0, 10) : ''}"></div>
    </div>
    <div class="modal-actions">
      <button class="btn ghost" onclick="closeModal()">取消</button>
      <button class="btn" id="f-save">保存</button>
    </div>
  `);
  $('#f-save').addEventListener('click', async () => {
    const payload = {
      title: $('#f-title').value.trim(),
      description: $('#f-desc').value,
      priority: $('#f-priority').value,
      dueDate: $('#f-due').value || null,
    };
    if (task) await patch('/api/tasks/' + task.id, payload);
    else await post('/api/tasks', { parentId: parentId || null, ...payload });
    closeModal();
    renderTasks();
  });
}

/* ---------- 灵感 ---------- */
function renderInspirations() {
  const root = $('#view-root');
  root.innerHTML = `
    <div class="toolbar">
      <div class="search-card organic-card"><span class="icon">🔍</span><input id="ins-search" placeholder="搜索灵感..."></div>
      <button class="btn" onclick="openInspirationForm()">＋ 记录灵感</button>
    </div>
    <div id="ins-grid" class="loading">加载中...</div>`;
  let timer = null;
  $('#ins-search').addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(loadInspirations, 250);
  });
  loadInspirations();
}

async function loadInspirations() {
  const q = $('#ins-search') ? $('#ins-search').value.trim() : '';
  const items = await get('/api/inspirations' + (q ? '?q=' + encodeURIComponent(q) : ''));
  $('#ins-badge').style.display = items.length ? '' : 'none';
  $('#ins-badge').textContent = items.length;
  const grid = $('#ins-grid');
  if (items.length === 0) {
    grid.className = '';
    grid.innerHTML = emptyHTML('还没有灵感', '捕捉脑海中闪过的每一个创意，让灵感像种子一样自然生长。', () => openInspirationForm());
    return;
  }
  grid.className = 'grid';
  grid.innerHTML = items.map(insHTML).join('');
  grid.querySelectorAll('[data-act]').forEach((el) => {
    el.addEventListener('click', async () => {
      const act = el.dataset.act, id = Number(el.dataset.id);
      if (act === 'pin') { await post('/api/inspirations/' + id + '/pin', {}); loadInspirations(); }
      else if (act === 'edit') {
        const list = await get('/api/inspirations');
        openInspirationForm(list.find(i => i.id === id));
      } else if (act === 'del') {
        if (!confirm('确定删除这条灵感？')) return;
        await del('/api/inspirations/' + id);
        loadInspirations();
      }
    });
  });
}

const COLOR_NAMES = { '#228B22': '森林', '#8B4513': '大地', '#87CEEB': '天空', '#D2B48C': '沙丘', '#556B2F': '苔藓', '#CD853F': '赭石', '#6B8E23': '橄榄', '#B8860B': '暗金' };

function insHTML(i) {
  const tags = i.tags.map(t => `<span class="tag-chip">#${esc(t)}</span>`).join('');
  return `<div class="ins-card">
    <div class="ins-top" style="background:${i.color}"></div>
    <div class="ins-body">
      <div class="ins-head">
        <h4>${esc(i.title) || '未命名灵感'}</h4>
        <button class="icon-btn" data-act="pin" data-id="${i.id}" title="${i.pinned ? '取消置顶' : '置顶'}">${i.pinned ? '📌' : '○'}</button>
      </div>
      <div class="ins-content">${esc(i.content)}</div>
    </div>
    ${tags ? `<div class="ins-tags">${tags}</div>` : ''}
    <div class="ins-foot">
      <span class="date">${fmtDate(i.createdAt)}</span>
      <span>
        <button class="icon-btn" data-act="edit" data-id="${i.id}" title="编辑">✎</button>
        <button class="icon-btn danger" data-act="del" data-id="${i.id}" title="删除">🗑</button>
      </span>
    </div>
  </div>`;
}

function openInspirationForm(ins) {
  const colors = Object.keys(COLOR_NAMES).map(c =>
    `<span class="color-dot ${(!ins || ins.color === c) ? 'sel' : ''}" data-c="${c}" style="background:${c}" title="${COLOR_NAMES[c]}"></span>`
  ).join('');
  openModal(`
    <h3>${ins ? '编辑灵感' : '记录灵感'}</h3>
    <div class="field"><label>标题</label><input class="organic-input" id="i-title" value="${ins ? escAttr(ins.title) : ''}" placeholder="灵感标题"></div>
    <div class="field"><label>内容</label><textarea class="organic-input" id="i-content" rows="4" placeholder="写下此刻的想法...">${ins ? esc(ins.content) : ''}</textarea></div>
    <div class="field"><label>标签（逗号分隔）</label><input class="organic-input" id="i-tags" value="${ins ? escAttr(ins.tags.join(', ')) : ''}" placeholder="自然, 灵感, 设计"></div>
    <div class="field"><label>颜色</label><div class="color-row" id="i-colors">${colors}</div></div>
    <div class="modal-actions">
      <button class="btn ghost" onclick="closeModal()">取消</button>
      <button class="btn" id="i-save">保存</button>
    </div>
  `);
  let color = ins ? ins.color : Object.keys(COLOR_NAMES)[0];
  document.querySelectorAll('#i-colors .color-dot').forEach(dot => {
    dot.addEventListener('click', () => {
      color = dot.dataset.c;
      document.querySelectorAll('#i-colors .color-dot').forEach(x => x.classList.toggle('sel', x === dot));
    });
  });
  $('#i-save').addEventListener('click', async () => {
    const payload = {
      title: $('#i-title').value.trim(),
      content: $('#i-content').value,
      tags: $('#i-tags').value.split(',').map(s => s.trim()).filter(Boolean),
      color,
      pinned: ins ? ins.pinned : false,
    };
    if (ins) await patch('/api/inspirations/' + ins.id, payload);
    else await post('/api/inspirations', payload);
    closeModal();
    loadInspirations();
  });
}

/* ---------- 通用 ---------- */
function emptyHTML(title, desc, cb) {
  return `<div class="empty">
    <div class="blob">${blobSVG()}</div>
    <h3>${title}</h3>
    <p>${desc}</p>
    <button class="btn" onclick="(${cb.toString()})()">＋ ${title.includes('任务') ? '新建任务' : '记录第一条灵感'}</button>
  </div>`;
}

function blobSVG() {
  return `<svg width="72" height="72" viewBox="0 0 72 72" fill="none">
    <path d="M36 4C50 10 58 22 56 38C54 54 42 68 28 66C14 64 4 52 8 38C12 24 22 18 36 4Z" fill="#228B22" fill-opacity="0.15"/>
    <path d="M36 10C46 14 52 24 50 36C48 48 40 58 30 57C20 56 12 48 16 37C20 26 28 22 36 10Z" fill="#228B22" fill-opacity="0.35"/>
    <path d="M36 18C42 21 46 28 44 36C42 44 38 50 32 49C26 48 22 43 24 36C26 29 31 26 36 18Z" fill="#228B22"/>
  </svg>`;
}

function openModal(html) {
  const mask = document.createElement('div');
  mask.className = 'modal-mask';
  mask.innerHTML = `<div class="modal">${html}</div>`;
  mask.addEventListener('click', (e) => { if (e.target === mask) closeModal(); });
  document.body.appendChild(mask);
}
function closeModal() { document.querySelector('.modal-mask')?.remove(); }

function statusLabel(s) {
  return { pending: '待办', in_progress: '进行中', completed: '已完成', cancelled: '已取消' }[s] || s;
}
function fmtDue(d) { const x = new Date(d); return isNaN(x) ? d : (x.getMonth() + 1) + '/' + x.getDate(); }
function fmtDate(d) { const x = new Date(d); return isNaN(x) ? d : x.toLocaleDateString('zh-CN'); }
function esc(s) { return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function escAttr(s) { return esc(s).replace(/"/g, '&quot;'); }

showView('tasks');
</script>
</body>
</html>
"""

if __name__ == "__main__":
    main()
