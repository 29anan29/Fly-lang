# FlyToDos —— 用 PyFly（Python 3.10+ 安全超集）像素级复刻，PyQt6 桌面版
# 原版：Wails + Vue（Organic Biophilic 主题）；本版：PyQt6 纯标准库数据层，零 Web 依赖。
# 用法：pip install PyQt6 && fly build example/flytodos_qt/flytodos_qt.fly -o flytodos_qt.py && python3 flytodos_qt.py

import json
import os
import sys
from datetime import datetime, timezone
from functools import cmp_to_key, partial

from PyQt6.QtCore import Qt, QTimer, QSize
from PyQt6.QtGui import QAction, QBrush, QColor, QPainter
from PyQt6.QtWidgets import QApplication, QMainWindow, QWidget, QHBoxLayout, QVBoxLayout, QTreeWidget, QTreeWidgetItem, QLineEdit, QPushButton, QLabel, QDialog, QTextEdit, QComboBox, QScrollArea, QGridLayout, QFrame, QMenu, QStackedWidget, QFormLayout, QButtonGroup

DATA_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "flytodos_qt_data.json")

STATUSES = ["pending", "in_progress", "completed", "cancelled"]
PRIORITIES = ["low", "medium", "high"]
COLORS = ["#228B22", "#8B4513", "#87CEEB", "#D2B48C", "#556B2F", "#CD853F", "#6B8E23", "#B8860B"]

STATUS_CN = {"pending": "待办", "in_progress": "进行中", "completed": "已完成", "cancelled": "已取消"}
PRI_CN = {"low": "低", "medium": "中", "high": "高"}
STATUS_MARK = {"pending": "\u25ef", "in_progress": "\u25d1", "completed": "\u25cf", "cancelled": "\u2715"}
STATUS_COLOR = {
    "pending": "#9E9E9E",
    "in_progress": "#1E88E5",
    "completed": "#43A047",
    "cancelled": "#E53935",
}
PRI_COLOR = {"low": "#8D6E63", "medium": "#F57C00", "high": "#D32F2F"}


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def empty_db():
    return {"tasks": [], "inspirations": [], "next_id": 1}


def load_db():
    try:
        f = open(DATA_FILE, encoding="utf-8")
    except Exception:
        return empty_db()
    try:
        return json.load(f)
    except Exception:
        return empty_db()
    finally:
        f.close()


def save_db(db):
    f = open(DATA_FILE, "w", encoding="utf-8")
    try:
        json.dump(db, f, ensure_ascii=False, indent=2)
    finally:
        f.close()


def next_id(db):
    nid = db["next_id"]
    db["next_id"] = nid + 1
    return nid


def normalize_task(payload):
    task = {
        "id": payload.get("id"),
        "parentId": payload.get("parentId"),
        "title": (payload.get("title") or "").strip(),
        "description": payload.get("description") or "",
        "status": payload.get("status") or "pending",
        "priority": payload.get("priority") or "medium",
        "sortOrder": payload.get("sortOrder") or 0,
        "dueDate": payload.get("dueDate"),
        "createdAt": payload.get("createdAt") or now_iso(),
        "updatedAt": now_iso(),
        "completedAt": payload.get("completedAt"),
    }
    if task["status"] not in STATUSES:
        task["status"] = "pending"
    if task["priority"] not in PRIORITIES:
        task["priority"] = "medium"
    return task


def normalize_inspiration(payload):
    tags = []
    for t in payload.get("tags") or []:
        tags.append(t)
    color = payload.get("color")
    if color not in COLORS:
        color = COLORS[0]
    return {
        "id": payload.get("id"),
        "title": (payload.get("title") or "").strip(),
        "content": payload.get("content") or "",
        "tags": tags,
        "color": color,
        "pinned": bool(payload.get("pinned")),
        "createdAt": payload.get("createdAt") or now_iso(),
        "updatedAt": now_iso(),
    }


def find_task(db, tid):
    for t in db["tasks"]:
        if t["id"] == tid:
            return t
    return None


def find_insp(db, iid):
    for i in db["inspirations"]:
        if i["id"] == iid:
            return i
    return None


def collect_subtree(db, tid, ids):
    ids.append(tid)
    for t in db["tasks"]:
        if t["parentId"] == tid:
            collect_subtree(db, t["id"], ids)


def task_cmp(a, b):
    sa = a.get("sortOrder") or 0
    sb = b.get("sortOrder") or 0
    if sa != sb:
        return -1 if sa < sb else 1
    if a["id"] != b["id"]:
        return -1 if a["id"] < b["id"] else 1
    return 0


def insp_cmp(a, b):
    if a["pinned"] != b["pinned"]:
        return -1 if a["pinned"] else 1
    if a["id"] != b["id"]:
        return -1 if a["id"] < b["id"] else 1
    return 0


def sorted_tasks(items):
    return sorted(items, key=cmp_to_key(task_cmp))


def sorted_inspirations(items):
    return sorted(items, key=cmp_to_key(insp_cmp))


