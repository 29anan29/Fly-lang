# ========== 2. only ==========
only (json, math):
    def parse(raw):
        data = json.loads(raw)
        return math.sqrt(data["x"])

# ========== 7. seal ==========
seal class Admin:
    role = "admin"

    def __init__(self, name):
        self.name = name

admin = Admin("Alice")

# ========== 8. trace ==========
trace(level="WARN", args=True, ret=True):
    def delete_user(uid):
        db.append(uid)
        return uid * 2

db = []
print(parse('{"x": 9}'))
print(admin.name, admin.role)
print(delete_user(7))
