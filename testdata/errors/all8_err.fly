# ========== 3. lock ==========
lock SECRET_KEY = "abc-123"


def hack3():
    SECRET_KEY = "new"


def hack3b():
    print(globals()['SECRET_KEY'])


# ========== 4. mask ==========
def login4(password):
    mask password
    print(f"密码: {password}")


def login4b(password):
    mask password
    logging.info(password)


