# ========== 6. guard ==========
def create_user6(username):
    guard username: str, len(username) > 0, len(username) <= 20


# ========== 7. seal ==========
seal class Admin7:
    role = "admin"


admin7 = Admin7()
admin7.role = "user"
admin7.permission = "all"


